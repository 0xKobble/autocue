{
  "name": "autocue",
  "version": "0.2.0",
  "description": "Autocue — Cue. Split. Mix. Anywhere. Music aggregator for cueing & mixing across streaming services with on-device AI stem splitting.",
  "private": true,
  "scripts": {
    "proto": "python3 -m http.server 5173 --directory prototype",
    "proto:serve": "npx --yes serve prototype -p 5173",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "mobile": "npm --prefix mobile start",
    "mobile:ios": "npm --prefix mobile run ios"
  },
  "keywords": [
    "dj",
    "music",
    "stems",
    "spotify",
    "apple-music",
    "autocue",
    "expo",
    "testflight"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  }
}
