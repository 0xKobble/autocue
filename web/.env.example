# Copy to web/.env.local and restart Vite. Never commit real secrets.

# --- YouTube / YouTube Music (Google Identity Services + YouTube Data API v3) ---
# Web OAuth client ID from Google Cloud Console (…apps.googleusercontent.com)
# Without this, Connect shows a setup CTA — no fake "Connected · demo".
VITE_GOOGLE_CLIENT_ID=

# --- SoundCloud (OAuth 2.1 Authorization Code + PKCE) ---
# Client ID from https://soundcloud.com/you/apps (or SoundCloud developer console)
# Redirect URI must be exactly: http://localhost:5173/  (trailing slash)
# Without this, Connect shows a setup CTA — no mock library.
VITE_SOUNDCLOUD_CLIENT_ID=

# Optional override (defaults to current origin + "/")
# VITE_SOUNDCLOUD_REDIRECT_URI=http://localhost:5173/

# Optional — confidential apps need a client secret for token exchange.
# Prefer the NON-VITE name so Vite never embeds it in the browser bundle.
# The Vite /api/soundcloud/token proxy adds it server-side during npm run dev.
# Ask SoundCloud to mark your app as a "public" client to omit the secret (PKCE only).
SOUNDCLOUD_CLIENT_SECRET=

# Dev-only fallback (exposes secret in the client bundle — avoid in production builds)
# VITE_SOUNDCLOUD_CLIENT_SECRET=
